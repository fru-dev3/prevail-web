#!/usr/bin/env bash
# Prevail — macOS desktop app installer.
#
# Usage:
#   curl -fsSL https://prevail.sh/install-mac | bash
#
# Downloads the latest signed + notarized DMG, installs Prevail.app into
# /Applications, clears the download quarantine, and launches it.
#
# Source: https://github.com/fru-dev3/prevail-web/blob/main/public/install-mac
# The .dmg is served from GitHub Releases (unlimited bandwidth).

set -euo pipefail

DMG_URL="https://github.com/fru-dev3/prevail-desktop/releases/latest/download/Prevail-mac-arm64.dmg"

gold=$'\033[38;5;179m'; green=$'\033[38;5;77m'; red=$'\033[38;5;203m'; dim=$'\033[2m'; reset=$'\033[0m'
step() { printf "${gold}◆${reset} %s\n" "$*"; }
ok()   { printf "${green}✓${reset} %s\n" "$*"; }
die()  { printf "${red}✗ %s${reset}\n" "$*" >&2; exit 1; }

[ "$(uname -s)" = "Darwin" ] || die "Prevail desktop is macOS-only. (For the CLI: curl -fsSL https://prevail.sh/install | bash)"

VOL=""
tmp="$(mktemp -d)"
cleanup() { [ -n "$VOL" ] && hdiutil detach "$VOL" >/dev/null 2>&1 || true; rm -rf "${tmp:-}"; }
trap cleanup EXIT

step "downloading Prevail"
curl -fSL --progress-bar "$DMG_URL" -o "$tmp/Prevail.dmg" || die "download failed — check https://github.com/fru-dev3/prevail-desktop/releases"
ok "downloaded $(du -h "$tmp/Prevail.dmg" | awk '{print $1}')"

step "installing to /Applications"
VOL="$(hdiutil attach -nobrowse -noautoopen "$tmp/Prevail.dmg" | grep -o '/Volumes/.*' | head -1)"
[ -n "$VOL" ] && [ -d "$VOL/Prevail.app" ] || die "could not mount the DMG"
rm -rf "/Applications/Prevail.app"
cp -R "$VOL/Prevail.app" /Applications/
hdiutil detach "$VOL" >/dev/null; VOL=""
xattr -dr com.apple.quarantine /Applications/Prevail.app 2>/dev/null || true
ok "installed → /Applications/Prevail.app"

step "launching"
open -a Prevail || true

printf "\n${green}◆${reset} ${gold}Prevail is installed.${reset} ${dim}Find it in /Applications or Spotlight.${reset}\n\n"
